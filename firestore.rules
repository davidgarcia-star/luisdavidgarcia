rules_version = '2';
// Reglas de seguridad de Firestore para el proyecto "juegos-miproaa"
// (cuentas de jugador de BIBLIXIA, BIBLIXIA 2, Desafío Bíblico RD y Desafío Bíblico RD 2).
// Cómo ponerlas: Firebase → Firestore Database → pestaña "Reglas" → borrar lo que hay,
// pegar TODO este archivo y tocar "Publicar".
//
// Qué hacen:
//  - Cada jugador solo puede leer, guardar o borrar SU PROPIO avance (jugadores/{su uid}).
//  - Nadie puede ver la lista de jugadores ni el avance de otra persona.
//  - Solo se aceptan los 3 campos que usan los juegos, con tamaño limitado.
//  - Contador de visitantes del sitio (contadores/sitio): cualquiera lo puede leer y solo
//    se puede subir de 1 en 1 (respaldo para cuando el contador de Abacus no responde).
//  - Combate de la Fe (duelos/{código}): partidas en línea 1 contra 1 de Desafío Bíblico RD 1 y 2.
//    Quien tiene el código puede leer esa partida; no se puede ver la lista de partidas.
//    Solo se aceptan los campos del juego (incluida la última reacción o mensaje rápido, «rx»),
//    con tamaño limitado, y no se pueden borrar.
//  - Cualquier otra colección queda cerrada.
service cloud.firestore {
  match /databases/{database}/documents {

    match /jugadores/{uid} {
      function esDueno() {
        return request.auth != null && request.auth.uid == uid;
      }
      function datosValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['datos', 'usuario', 't'])
          && d.datos is string && d.datos.size() < 900000
          && d.usuario is string && d.usuario.size() <= 60
          && d.t is int;
      }
      allow get, delete: if esDueno();
      allow create, update: if esDueno() && datosValidos();
      allow list: if false;
    }

    match /contadores/{id} {
      allow get: if id == 'sitio';
      allow create: if id == 'sitio'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int
        && request.resource.data.n >= 0 && request.resource.data.n < 10000000;
      allow update: if id == 'sitio'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow list, delete: if false;
    }

    match /duelos/{code} {
      function jugador(p) {
        return p is map && p.keys().hasOnly(['nom', 'pts', 'i', 'ms', 'fin', 't', 'rx'])
          && (!('rx' in p) || (p.rx is string && p.rx.size() <= 24))
          && p.nom is string && p.nom.size() > 0 && p.nom.size() <= 20
          && p.pts is int && p.pts >= 0 && p.pts <= 35
          && p.i is int && p.i >= 0 && p.i <= 35
          && p.ms is int && p.ms >= 0 && p.ms < 2000000
          && p.fin is bool && p.t is int;
      }
      allow get: if code.size() == 6;
      allow create: if code.size() == 6
        && request.resource.data.keys().hasOnly(['lvl', 'n', 'qs', 'seed', 'h', 't'])
        && request.resource.data.lvl in ['basico', 'intermedio', 'avanzado']
        && request.resource.data.n in [10, 20, 35]
        && request.resource.data.qs is string && request.resource.data.qs.size() < 300
        && request.resource.data.seed is int && request.resource.data.t is int
        && jugador(request.resource.data.h);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['h', 'g'])
        && jugador(request.resource.data.h)
        && (!('g' in request.resource.data) || jugador(request.resource.data.g))
        // el segundo jugador solo entra si el lugar está libre; después solo actualiza su propio marcador
        && (!('g' in resource.data) || request.resource.data.g.nom == resource.data.g.nom);
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
